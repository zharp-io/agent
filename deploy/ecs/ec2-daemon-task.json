{
  "family": "zharp-collector",
  "networkMode": "host",
  "requiresCompatibilities": [
    "EC2"
  ],
  "containerDefinitions": [
    {
      "name": "zharp-collector",
      "image": "ghcr.io/zharp-io/agent:latest",
      "essential": true,
      "user": "0:0",
      "portMappings": [
        {
          "containerPort": 4317,
          "hostPort": 4317,
          "protocol": "tcp"
        },
        {
          "containerPort": 4318,
          "hostPort": 4318,
          "protocol": "tcp"
        },
        {
          "containerPort": 13133,
          "hostPort": 13133,
          "protocol": "tcp"
        }
      ],
      "secrets": [
        {
          "name": "ZHARP_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:zharp/api-key"
        }
      ],
      "mountPoints": [
        {
          "sourceVolume": "docker-containers",
          "containerPath": "/var/lib/docker/containers",
          "readOnly": true
        },
        {
          "sourceVolume": "docker-sock",
          "containerPath": "/var/run/docker.sock",
          "readOnly": false
        },
        {
          "sourceVolume": "hostfs",
          "containerPath": "/hostfs",
          "readOnly": true
        },
        {
          "sourceVolume": "collector-config",
          "containerPath": "/etc/zharp-collector",
          "readOnly": true
        },
        {
          "sourceVolume": "collector-state",
          "containerPath": "/var/lib/zharp-collector",
          "readOnly": false
        }
      ],
      "healthCheck": {
        "command": [
          "CMD",
          "/zharp-collector",
          "health"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 10
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/zharp-collector",
          "awslogs-region": "REGION",
          "awslogs-stream-prefix": "collector",
          "awslogs-create-group": "true"
        }
      },
      "resourceRequirements": [],
      "cpu": 256,
      "memory": 256,
      "memoryReservation": 128
    }
  ],
  "volumes": [
    {
      "name": "docker-containers",
      "host": {
        "sourcePath": "/var/lib/docker/containers"
      }
    },
    {
      "name": "docker-sock",
      "host": {
        "sourcePath": "/var/run/docker.sock"
      }
    },
    {
      "name": "hostfs",
      "host": {
        "sourcePath": "/"
      }
    },
    {
      "name": "collector-config",
      "host": {
        "sourcePath": "/etc/zharp-collector"
      }
    },
    {
      "name": "collector-state",
      "host": {
        "sourcePath": "/var/lib/zharp-collector"
      }
    }
  ]
}
